          <mxGeometry x="620" y="60" width="140" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="p2-noteRule" value="Sai lần 1: hiện gợi ý và cho làm lại. Sai lần 2: hiện lời giải rồi chuyển câu" style="shape=mxgraph.flowchart.annotation_1;html=1;align=left;whiteSpace=wrap;verticalAlign=middle;spacingLeft=10;fontSize=11;fontColor=#555555;strokeColor=#9E9E9E;" vertex="1" parent="p2-laneA">
