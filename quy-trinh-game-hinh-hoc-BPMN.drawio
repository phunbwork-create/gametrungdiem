  <!-- ==================================================================== -->
  <!-- TRANG 3 - CHÚ THÍCH KÝ HIỆU VÀ QUY TẮC NGHIỆP VỤ                     -->
  <!-- ==================================================================== -->
  <diagram id="pg3" name="3. Chú thích và quy tắc">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="p3-title" value="CHÚ THÍCH KÝ HIỆU BPMN 2.0 VÀ QUY TẮC NGHIỆP VỤ" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#2F3E52;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="900" height="40" as="geometry"/>
        </mxCell>

        <!-- Khung chú thích ký hiệu -->
        <mxCell id="p3-box1" value="A. Ký hiệu đã dùng" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=15;fontStyle=1;fillColor=none;strokeColor=#8497B0;fontColor=#2F3E52;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="680" height="700" as="geometry"/>
        </mxCell>

        <mxCell id="p3-s1" value="" style="shape=mxgraph.bpmn.shape;html=1;perimeter=ellipsePerimeter;outlineConnect=0;outline=standard;symbol=message;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="80" y="155" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p3-l1" value="&lt;b&gt;Start Event&lt;/b&gt; - sự kiện bắt đầu quy trình (có hình phong bì = bắt đầu bằng một thông điệp nhận được)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="150" width="540" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="p3-s2" value="" style="shape=mxgraph.bpmn.shape;html=1;perimeter=ellipsePerimeter;outlineConnect=0;outline=end;symbol=general;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="80" y="215" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p3-l2" value="&lt;b&gt;End Event&lt;/b&gt; - sự kiện kết thúc (viền đậm)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="215" width="540" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="p3-s3" value="Hoạt động" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="275" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p3-l3" value="&lt;b&gt;Task&lt;/b&gt; - một công việc. Màu phân theo lane: vàng = bé làm, xanh dương = giao diện hiển thị, xanh lá = hệ thống xử lý" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="270" width="540" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="p3-s4" value="Sub-process" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="335" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p3-l4" value="&lt;b&gt;Sub-process có vòng lặp&lt;/b&gt; - dấu + nghĩa là gói gọn một quy trình con (mở ở Trang 2), dấu ↻ nghĩa là lặp lại nhiều lần" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="330" width="540" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="p3-s5" value="" style="shape=mxgraph.bpmn.shape;html=1;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=exclusiveGw;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="75" y="395" width="50" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p3-l5" value="&lt;b&gt;Exclusive Gateway (XOR)&lt;/b&gt; - điểm rẽ nhánh: chỉ đi theo đúng MỘT nhánh thoả điều kiện. Cũng dùng để gộp các nhánh lại" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="390" width="540" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="p3-s6" value="" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="65" y="460" width="70" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="p3-l6" value="&lt;b&gt;Data Store&lt;/b&gt; - nơi lưu dữ liệu lâu dài. Ở đây là localStorage của trình duyệt" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="460" width="540" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="p3-s7a" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="90" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p3-s7b" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#2F3E52;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="65" y="540" as="sourcePoint"/>
            <mxPoint x="140" y="540" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p3-l7" value="&lt;b&gt;Sequence Flow&lt;/b&gt; - trình tự thực hiện bên trong cùng một pool (nét liền, mũi tên đặc)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="518" width="540" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="p3-s8" value="" style="endArrow=open;endFill=0;startArrow=oval;startFill=0;dashed=1;html=1;strokeColor=#444444;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="65" y="595" as="sourcePoint"/>
            <mxPoint x="140" y="595" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p3-l8" value="&lt;b&gt;Message Flow&lt;/b&gt; - thông điệp trao đổi giữa hai pool khác nhau (nét đứt, đầu tròn rỗng)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="573" width="540" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="p3-s9" value="Ghi chú" style="shape=mxgraph.flowchart.annotation_1;html=1;align=left;whiteSpace=wrap;verticalAlign=middle;spacingLeft=8;fontSize=11;fontColor=#555555;strokeColor=#9E9E9E;" vertex="1" parent="1">
          <mxGeometry x="60" y="635" width="85" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="p3-l9" value="&lt;b&gt;Text Annotation&lt;/b&gt; - lời chú thích thêm, nối bằng nét đứt (Association), không ảnh hưởng tới luồng chạy" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="633" width="540" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="p3-s10" value="Lane" style="swimlane;html=1;horizontal=0;startSize=22;fillColor=none;strokeColor=#8497B0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="90" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p3-l10" value="&lt;b&gt;Pool / Lane&lt;/b&gt; - Pool là một bên tham gia; Lane là vai trò bên trong pool. Ở đây: Học sinh, Giao diện, Bộ máy Game, Lưu trữ" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="698" width="540" height="55" as="geometry"/>
        </mxCell>

        <!-- Khung quy tắc nghiệp vụ -->
        <mxCell id="p3-box2" value="B. Quy tắc nghiệp vụ (Business Rules)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=15;fontStyle=1;fillColor=none;strokeColor=#8497B0;fontColor=#2F3E52;" vertex="1" parent="1">
          <mxGeometry x="760" y="100" width="780" height="700" as="geometry"/>
        </mxCell>

        <mxCell id="p3-r1" value="&lt;b&gt;BR-01 Số câu mỗi lượt&lt;/b&gt;&lt;br&gt;Mỗi lượt chơi gồm đúng 8 câu hỏi, sinh ngẫu nhiên từ ngân hàng dạng bài của chủ đề đã chọn." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="790" y="150" width="720" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="p3-r2" value="&lt;b&gt;BR-02 Tính điểm&lt;/b&gt;&lt;br&gt;Đúng ngay lần đầu: +10 điểm. Đúng ở lần thử thứ hai: +5 điểm. Sai cả hai lần: 0 điểm. Tối đa 80 điểm một lượt." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="790" y="225" width="720" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="p3-r3" value="&lt;b&gt;BR-03 Chính sách làm lại (sư phạm)&lt;/b&gt;&lt;br&gt;Sai lần 1: hệ thống chỉ hiện GỢI Ý và cho bé làm lại, không hiện đáp án. Sai lần 2: hiện lời giải chi tiết rồi mới chuyển câu." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="790" y="300" width="720" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="p3-r4" value="&lt;b&gt;BR-04 Luôn giải thích&lt;/b&gt;&lt;br&gt;Mọi câu hỏi đều hiện lời giải, kể cả khi bé trả lời đúng, để củng cố cách làm thay vì chỉ báo đúng hay sai." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="790" y="381" width="720" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="p3-r5" value="&lt;b&gt;BR-05 Xếp hạng sao&lt;/b&gt;&lt;br&gt;Theo tỉ lệ điểm đạt được trên 80: từ 90% trở lên = 3 sao; từ 70% = 2 sao; từ 50% = 1 sao; dưới 50% = 0 sao." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="790" y="456" width="720" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="p3-r6" value="&lt;b&gt;BR-06 Ghi kỷ lục&lt;/b&gt;&lt;br&gt;Chỉ ghi đè số sao đã lưu khi số sao của lượt mới CAO HƠN kỷ lục cũ, để bé không bị mất thành tích khi chơi thử." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="790" y="531" width="720" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="p3-r7" value="&lt;b&gt;BR-07 Dữ liệu cá nhân&lt;/b&gt;&lt;br&gt;Tiến độ chỉ lưu trong localStorage của trình duyệt trên máy, không gửi ra ngoài, không cần tài khoản và không cần mạng." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="790" y="606" width="720" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="p3-r8" value="&lt;b&gt;BR-08 Phạm vi kiến thức&lt;/b&gt;&lt;br&gt;7 thử thách phủ 4 mảng của chương trình Toán hình lớp 3: điểm ở giữa và trung điểm; hình tròn; góc và hình phẳng, hình khối; chu vi và diện tích." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="790" y="681" width="720" height="68" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
