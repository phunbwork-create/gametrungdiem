        <mxCell id="p2-noteMode" value="4 dạng: chọn đáp án · bàn phím số · bấm chỉ trên hình · kéo thả điểm" style="shape=mxgraph.flowchart.annotation_1;html=1;align=left;whiteSpace=wrap;verticalAlign=middle;spacingLeft=10;fontSize=11;fontColor=#555555;strokeColor=#9E9E9E;" vertex="1" parent="p2-laneB">
